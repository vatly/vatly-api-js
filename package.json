{
  "name": "@getvatly/sdk",
  "version": "0.3.0-alpha.3",
  "description": "Official TypeScript SDK for Vatly, the European Merchant of Record for AI, software and digital products",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vatly/vatly-api-js.git"
  },
  "homepage": "https://github.com/vatly/vatly-api-js#readme",
  "bugs": {
    "url": "https://github.com/vatly/vatly-api-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "art/banner.png",
    "openapi.yaml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/test-package.mjs",
    "check": "pnpm gen:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:package",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm gen:check && pnpm typecheck && pnpm lint && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.14.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.8.1"
  },
  "keywords": [
    "vatly",
    "merchant-of-record",
    "billing",
    "payments",
    "saas",
    "ai",
    "vat",
    "europe",
    "sdk",
    "typescript"
  ]
}
