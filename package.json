{
  "name": "@vatly/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for Vatly, the Merchant of Record for European software and digital products",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vatly/vatly-js.git"
  },
  "homepage": "https://github.com/vatly/vatly-js#readme",
  "bugs": {
    "url": "https://github.com/vatly/vatly-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "prepublishOnly": "pnpm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.14.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "vatly",
    "merchant-of-record",
    "billing",
    "saas",
    "vat",
    "europe",
    "sdk",
    "typescript"
  ]
}
